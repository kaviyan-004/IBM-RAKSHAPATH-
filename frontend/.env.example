# Base URL of the RakshaPath backend (FastAPI). Only used when VITE_USE_MOCK=false.
VITE_API_BASE_URL=http://localhost:8000

# When true, the API layer (src/api/*) serves data from src/data/mock instead of
# calling the backend. Flip to false once the real endpoints described in
# docs/BACKEND_SCHEMA.md are live.
VITE_USE_MOCK=true
