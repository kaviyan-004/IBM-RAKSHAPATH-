# Copy to backend/.env and adjust for your environment. Never commit backend/.env.

DEBUG=False

# MongoDB connection string (Local MongoDB or MongoDB Atlas URI)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=rakshapath_db

# Change in production
SECRET_KEY=rakshapath-safety-secret-key-production-change-me

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
