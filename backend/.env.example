# Copy to backend/.env and adjust for your environment. Never commit backend/.env.

DEBUG=False

# SQLite by default; swap for PostgreSQL + PostGIS per docs/BACKEND_SCHEMA.md
DATABASE_URL=sqlite:///./road_safety.db

# Change in production
SECRET_KEY=your-secret-key-change-in-production

# Comma-separated list is NOT supported by pydantic's List[str] env parsing here;
# this is a JSON array string, matching config.py's ALLOWED_ORIGINS: List[str]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
